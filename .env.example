TG_API_ID=12345678
TG_API_HASH=请填 my.telegram.org 给你的 api_hash
WEB_PASSWORD=请设一个强网页密码，不设就是不设防
# 24位随机字母数字访问路径，安装时自动生成，可用 tg reset-path 重置
WEB_PATH=请用 tg reset-path 生成一个24位路径
# 并行下载数：默认 2，最多 4，可用 tg set-parallel 修改
TG_PARALLEL=2
# 私有备份仓库（可选），用 tg set-backup-repo / tg set-backup-token 设置
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_TOKEN=请用 tg set-backup-token 设置
